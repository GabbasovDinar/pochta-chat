# This settings are used for database connection

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pochta_chat_db
DATABASE_HOST=postgres
DATABASE_PORT=5432

# This is the database connection optional string
# You can uncomment it and change the values as you want

# DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${POSTGRES_DB}

# This settings defined in the core/config.py file with default values
# You can uncomment them and change the values as you want

# This settings are used for JWT token generation
# SECRET_KEY=your-secret-key
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# This settings are used for password hashing
# PASSWORD_CRYPT_ALGORITHM=bcrypt
# PASSWORD_HASHING_ROUNDS=12
